[Unit]
Description=HelixLLM Gateway (multi-provider LLM router)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/milos/.local/bin
Environment=HELIXLLM_CONFIG=${XDG_CONFIG_HOME:-%h/.config}/helixllm/gateway.yaml
WorkingDirectory=/home/milos/Factory/projects/tools_and_research/helix_code/submodules/helix_llm
ExecStart=/home/milos/.local/bin/helixllm
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
LimitNOFILE=65536

[Install]
WantedBy=default.target
