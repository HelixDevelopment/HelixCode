[Unit]
Description=HelixCode AI Development Server (main binary) on :8081
Documentation=file://@HELIX_ROOT@/helix_code/cmd/server/README.md
# Ordered last: the server's llm.default_provider=local expects the coder lane,
# and its infraboot expects Postgres/Redis. Wants= (not Requires=) so the server
# still starts and reports its own health if a backend is degraded -- it has its
# own infraboot fallback path.
After=network-online.target helixcode-infra.service helixllm-coder.service helixllm-gateway.service
Wants=network-online.target helixcode-infra.service helixllm-coder.service
PartOf=helix.target

[Service]
# INFRA OWNERSHIP (operator decision, 2026-07-28): helixcode-infra.service is the
# SOLE owner of this server's datastores. Without this, internal/infraboot
# EnsureInfra rewrites cfg.Database.*/cfg.Redis.* UNCONDITIONALLY
# (infraboot.go:247-257) with its own 55432/56379 defaults and boots a SECOND
# postgres+redis pair -- while this unit declares Wants=helixcode-infra.service
# and then ignores it, making every DB/Redis line in replica-8081.yaml dead config.
Environment=HELIX_AUTOBOOT_INFRA=false

Type=simple
# podman is required by the server's infraboot (auto-boots its Postgres+Redis).
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HELIX_CONFIG=@HELIX_ROOT@/helix_code/config/replica-8081.yaml
EnvironmentFile=-@HELIX_ROOT@/.env
WorkingDirectory=@HELIX_ROOT@/helix_code
ExecStart=@HELIX_ROOT@/helix_code/bin/helixcode server
# Mirrors packaging/debian/helixcode.service (Restart=on-failure, RestartSec=10,
# LimitNOFILE=65536) adapted to user scope.
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
TimeoutStartSec=180

[Install]
WantedBy=helix.target
