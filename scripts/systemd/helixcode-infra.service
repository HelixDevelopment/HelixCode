[Unit]
Description=HelixCode Infrastructure (PostgreSQL + Redis via podman compose)
After=network-online.target podman.socket
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/milos/Factory/projects/tools_and_research/helix_code
ExecStart=/usr/bin/podman compose -f compose.helixcode-infra.yml up -d
ExecStop=/usr/bin/podman compose -f compose.helixcode-infra.yml down
TimeoutStartSec=120

[Install]
WantedBy=default.target
