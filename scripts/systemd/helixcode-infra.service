[Unit]
Description=HelixCode Infrastructure (PostgreSQL, Redis, Weaviate, Qdrant, ChromaDB, Cognee, Ollama)
Documentation=file://@HELIX_ROOT@/docs/SYSTEMD.md
After=network-online.target
Wants=network-online.target
PartOf=helix.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=@HELIX_ROOT@
ExecStart=/usr/bin/podman compose -f compose.helixcode-infra.yml up -d

# ExecStartPost is load-bearing for ORDERING, not a nicety (HXC-228).
#
# `podman compose up -d` returns as soon as the containers are CREATED, long
# before they serve. Without this wait, a consumer's After=helixcode-infra.service
# orders it after container *creation* only — so systemd considers this unit
# "started" while Postgres, Cognee et al. are still initialising, and the
# ordering relationship consumers rely on is a lie.
#
# Observed on a real cold boot
# (docs/qa/live_systemd_boot_20260806T145857Z/11_helixagent_coldboot_race.txt):
# helixagent started, probed Cognee and exited fatally all within the SAME
# second this unit reported success, because Cognee — whose compose entry waits
# on postgres+redis being healthy, making it one of the last to serve — was
# still coming up. The identical probe passed 15 s later.
#
# The script is read-only (podman inspect only), scoped to helixcode-infra-*
# containers, and bounded well inside TimeoutStartSec below.
ExecStartPost=@HELIX_ROOT@/scripts/systemd/wait-infra-ready.sh

ExecStop=/usr/bin/podman compose -f compose.helixcode-infra.yml down

# KillMode=process is load-bearing, not cosmetic.
#
# `podman compose up -d` returns immediately but leaves conmon + rootlessport
# (the host-side port forwarders) parented into THIS unit's cgroup. Under the
# default KillMode=control-group, any stop -- or any FAILURE -- makes systemd
# SIGKILL the entire cgroup, which kills the port forwarders of every container
# in the stack while the containers themselves survive.
#
# Observed 2026-07-24: a single weaviate port clash failed this unit, and
# systemd's cgroup teardown silently severed the host bindings of all ten
# sibling containers. `podman ps` kept reporting "Up (healthy) 0.0.0.0:5433->..."
# because the containers were alive -- only the forwarders were gone. Nothing on
# the host could reach Postgres, Redis, ChromaDB, Cognee or Qdrant for two days.
#
# KillMode=process confines the kill to the main process (the already-exited
# compose command), leaving container supervision intact. Teardown is handled
# explicitly and correctly by ExecStop.
KillMode=process
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=helix.target
